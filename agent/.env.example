# Copy this file to .env and fill it in.  cp .env.example .env

# From @BotFather in Telegram (see README.md)
TELEGRAM_BOT_TOKEN=

# From https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# The box
PI_URL=http://lockin.local:8000

# Your name, used in auto-replies: "Dimitri is locked in until 15:00"
OWNER_NAME=Dimitri

# Optional: your Telegram user id. Leave empty and the first person to send /start becomes the owner.
OWNER_ID=

# Digest every N seconds (300 = 5 min). Use 30 for the demo.
DIGEST_SECONDS=300

# Optional: if set, you must send "/start <code>" to become the owner (stops strangers claiming the bot).
OWNER_CLAIM_CODE=

# Rate limits for the study buddy
QUESTIONS_PER_SESSION=20
QUESTIONS_PER_HOUR_IDLE=30
OWNER_PER_MINUTE=6

# Rate limits for other people messaging the bot
SENDER_PER_MINUTE=5
SENDER_PER_SESSION=40

# Gemini spend caps (protect the key). Over the cap → keyword rules, no API call.
GEMINI_MAX_PER_MINUTE=12
GEMINI_MAX_PER_DAY=400
